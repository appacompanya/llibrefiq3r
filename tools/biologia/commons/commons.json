 "Cell membrane detailed diagram en.svg": {
  "url": "https://upload.wikimedia.org/wikipedia/commons/d/da/Cell_membrane_detailed_diagram_en.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
  "descurl": "https://commons.wikimedia.org/wiki/File:Cell_membrane_detailed_diagram_en.svg",
  "w": 877,
  "h": 361,
  "license": "Public domain",
  "artist": "<a href=\"//commons.wikimedia.org/wiki/User:LadyofHats\" title=\"User:LadyofHats\">Mariana Ruiz</a>",
  "credit": "<span class=\"int-own-work\" lang=\"en\">Own work</span>",
  "desc": "The cell membrane, also called the plasma membrane or plasmalemma, is a semipermeable lipid bilayer common to all living cells. It contains a variety of biological molecules, primarily proteins and lipids, which are involved in a vast array of cellular processes. It also serves as the attachment point for both the intracellular cytoskeleton and, if present, the cell wall.",
  "file": "Cell membrane detailed diagram en.svg"
 },
 "Cell membrane detailed diagram ca.svg": {
  "url": "https://upload.wikimedia.org/wikipedia/commons/0/02/Cell_membrane_detailed_diagram_ca.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
  "descurl": "https://commons.wikimedia.org/wiki/File:Cell_membrane_detailed_diagram_ca.svg",
  "w": 877,
  "h": 361,
  "license": "Public domain",
  "artist": "<a href=\"//commons.wikimedia.org/wiki/User:LadyofHats\" title=\"User:LadyofHats\">LadyofHats</a>, traducció <a href=\"//commons.wikimedia.org/wiki/User:Imartin6\" title=\"User:Imartin6\">User:imartin6</a>",
  "credit": "Traducció de Cell_membrane_detailed_diagram.svg",
  "desc": "La membrana cel·lular o membrana plasmàtica, comuna a tots els éssers vius, és una bicapa lipídica semipermeable. A més dels lípids conté altres molècules com proteïnes, implicades a una gran varietat de processos cel·lulars. És també el punt d'ancoratge del citoesquelet cel·lular i, si n'hi ha, de la paret cel·lular.",
  "file": "Cell membrane detailed diagram ca.svg"
 },
